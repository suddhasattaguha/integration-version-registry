  "glossary": [
    {
      "id": "scenario",
      "term": "scenario",
      "definition": "An end-to-end integration flow between connected applications.",
      "aliases": []
    },
    {
      "id": "integration-platform-ipaas",
      "term": "integration platform (iPaaS)",
      "definition": "A platform that runs integration processes and exposes APIs (e.g. SAP BTP Integration Suite).",
      "aliases": []
    },
    {
      "id": "message-broker",
      "term": "message broker",
      "definition": "A platform that carries events on topics and queues (e.g. Solace).",
      "aliases": []
    },
    {
      "id": "integration-component",
      "term": "integration component",
      "definition": "A named artifact on a platform or broker (an iFlow, a topic asset \u2026).",
      "aliases": [
        "asset"
      ]
    },
    {
      "id": "part",
      "term": "part",
      "definition": "A piece of a component: API, process, topic, queue, file or scheduler.",
      "aliases": []
    },
    {
      "id": "connected-system-application",
      "term": "connected system / application",
      "definition": "An application that calls a flow or receives from it.",
      "aliases": [
        "connected system"
      ]
    },
    {
      "id": "endpoint",
      "term": "endpoint",
      "definition": "The API or folder of an application a flow uses.",
      "aliases": []
    },
    {
      "id": "caller",
      "term": "caller",
      "definition": "The application that calls an exposed API (= an application).",
      "aliases": []
    },
    {
      "id": "export",
      "term": "export",
      "definition": "One hand-over from Pattern Bench to the registry \u2014 counted, not a version.",
      "aliases": []
    },
    {
      "id": "version",
      "term": "version",
      "definition": "A version of a component part (v1, v2 \u2026); at most two live at a time.",
      "aliases": []
    }
  ],
  "namingRules": [
    {
      "id": "N-1",
      "target": "part",
      "when": {
        "partType": "api"
      },
      "mode": "derive",
      "segments": [
        {
          "source": "platform.code"
        },
        {
          "delimiter": "_"
        },
        {
          "source": "component.code"
        },
        {
          "delimiter": "_"
        },
        {
          "source": "partType",
          "map": {
            "api": "API",
            "process": "IF",
            "topic": "TP",
            "queue": "Q",
            "file": "FL",
            "scheduler": "SCH"
          }
        },
        {
          "delimiter": "_"
        },
        {
          "source": "free",
          "label": "Purpose",
          "optional": true,
          "maxLength": 20
        },
        {
          "delimiter": "_"
        },
        {
          "source": "version",
          "format": "v{n}",
          "optional": true
        }
      ],
      "transforms": [
        "upper",
        "noSpaces"
      ],
      "maxLength": 60,
      "override": "warn",
      "level": "block"
    },
    {
      "id": "N-2",
      "target": "part",
      "when": {
        "partType": "process"
      },
      "mode": "derive",
      "segments": [
        {
          "source": "platform.code"
        },
        {
          "delimiter": "_"
        },
        {
          "source": "component.code"
        },
        {
          "delimiter": "_"
        },
        {
          "source": "literal",
          "text": "IF"
        },
        {
          "delimiter": "_"
        },
        {
          "source": "version",
          "format": "v{n}",
          "optional": true
        }
      ],
      "transforms": [
        "upper",
        "noSpaces"
      ],
      "maxLength": 60,
      "override": "allow",
      "level": "warn"
    },
    {
      "id": "N-3",
      "target": "part",
      "when": {},
      "mode": "derive",
      "segments": [
        {
          "source": "platform.code"
        },
        {
          "delimiter": "_"
        },
        {
          "source": "component.code"
        },
        {
          "delimiter": "_"
        },
        {
          "source": "partType",
          "map": {
            "api": "API",
            "process": "IF",
            "topic": "TP",
            "queue": "Q",
            "file": "FL",
            "scheduler": "SCH"
          }
        },
        {
          "delimiter": "_"
        },
        {
          "source": "version",
          "format": "v{n}",
          "optional": true
        }
      ],
      "transforms": [
        "upper",
        "noSpaces"
      ],
      "maxLength": 60,
      "override": "block",
      "level": "warn"
    }
  ],
